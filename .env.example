# Copy this file to `.env` and fill in your real values. Never commit `.env`.
# Expo loads `.env` at dev-server start — not `.env.example`.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Clerk (authentication)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Directions API (OpenRouteService)
EXPO_PUBLIC_ORS_API_KEY=your-ors-token

# Map tiles — Stadia Maps (Alidade Smooth). Free tier at stadiamaps.com.
# Without a key the map automatically falls back to CARTO Voyager (no account needed).
EXPO_PUBLIC_STADIA_API_KEY=your-stadia-key

# Direct Postgres password (SQL editor / psql only — never used by the app)
dbPass=your-db-password